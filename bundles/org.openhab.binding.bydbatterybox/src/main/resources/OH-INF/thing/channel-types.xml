				<option value="BMS2:5">BMS 2: Stop charging</option>
				<option value="BMS2:6">BMS 2: Start discharging</option>
				<option value="BMS2:7">BMS 2: Stop discharging</option>
				<option value="BMS2:8">BMS 2: SoC calibration (rough)</option>
				<option value="BMS2:9">BMS 2: SoC calibration (fine)</option>
				<option value="BMS2:10">BMS 2: SoC calibration stop</option>
				<option value="BMS2:11">BMS 2: CAN communication failed</option>
				<option value="BMS2:12">BMS 2: Serial communication failed</option>
				<option value="BMS2:13">BMS 2: Pre-charge command received</option>
				<option value="BMS2:14">BMS 2: Pre-charge successful</option>
				<option value="BMS2:15">BMS 2: Pre-charge failed</option>
				<option value="BMS2:16">BMS 2: End SoC calibration started</option>
				<option value="BMS2:17">BMS 2: Start balancing</option>
				<option value="BMS2:18">BMS 2: Stop balancing</option>
				<option value="BMS2:19">BMS 2: Address registered</option>
				<option value="BMS2:20">BMS 2: System functional safety fault</option>
				<option value="BMS2:21">BMS 2: Events additional info</option>
				<option value="BMS2:101">BMS 2: Firmware update started</option>
				<option value="BMS2:102">BMS 2: Firmware update successful</option>
