<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="bydbatterybox"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<channel-type id="state-of-charge">
		<item-type unitHint="%">Number:Dimensionless</item-type>
		<label>State of Charge</label>
		<tags>
			<tag>Measurement</tag>
			<tag>StateOfCharge</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %%"/>
	</channel-type>

	<channel-type id="state-of-health">
		<item-type unitHint="%">Number:Dimensionless</item-type>
		<label>State of Health</label>
		<description>Remaining capacity relative to the nominal capacity, as estimated by the battery.</description>
		<tags>
			<tag>Measurement</tag>
		</tags>
		<state readOnly="true" pattern="%.0f %%"/>
	</channel-type>

	<channel-type id="voltage">
		<item-type>Number:ElectricPotential</item-type>
		<label>Voltage</label>
		<tags>
			<tag>Measurement</tag>
			<tag>Voltage</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="voltage-calculated">
		<item-type>Number:ElectricPotential</item-type>
		<label>Voltage</label>
		<description>Calculated from the cell voltages.</description>
		<tags>
			<tag>Calculation</tag>
			<tag>Voltage</tag>
		</tags>
		<state readOnly="true" pattern="%.2f %unit%"/>
	</channel-type>

	<channel-type id="current">
		<item-type>Number:ElectricCurrent</item-type>
		<label>Current</label>
		<description>Battery current. Positive while discharging, negative while charging.</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Current</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="power">
		<item-type>Number:Power</item-type>
		<label>Power</label>
		<description>Current multiplied by output voltage. Positive while discharging, negative while charging.</description>
		<tags>
			<tag>Calculation</tag>
			<tag>Power</tag>
		</tags>
		<state readOnly="true" pattern="%.0f %unit%"/>
	</channel-type>

	<channel-type id="cell-voltage">
		<item-type unitHint="mV">Number:ElectricPotential</item-type>
		<label>Cell Voltage</label>
		<tags>
			<tag>Measurement</tag>
			<tag>Voltage</tag>
		</tags>
		<state readOnly="true" pattern="%.0f %unit%"/>
	</channel-type>

	<channel-type id="cell-voltage-calculated">
		<item-type unitHint="mV">Number:ElectricPotential</item-type>
		<label>Cell Voltage</label>
		<description>Calculated from the cell voltages.</description>
		<tags>
			<tag>Calculation</tag>
			<tag>Voltage</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="cell-number">
		<item-type>Number</item-type>
		<label>Cell Number</label>
		<description>1-based number of the cell or sensor within the tower.</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="temperature">
		<item-type>Number:Temperature</item-type>
		<label>Temperature</label>
		<tags>
			<tag>Measurement</tag>
			<tag>Temperature</tag>
		</tags>
		<state readOnly="true" pattern="%.0f %unit%"/>
	</channel-type>

	<channel-type id="temperature-calculated">
		<item-type>Number:Temperature</item-type>
		<label>Temperature</label>
		<tags>
			<tag>Calculation</tag>
			<tag>Temperature</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="energy">
		<item-type unitHint="kWh">Number:Energy</item-type>
		<label>Energy</label>
		<tags>
			<tag>Measurement</tag>
			<tag>Energy</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="energy-calculated">
		<item-type unitHint="kWh">Number:Energy</item-type>
		<label>Energy</label>
		<tags>
			<tag>Calculation</tag>
			<tag>Energy</tag>
		</tags>
		<state readOnly="true" pattern="%.2f %unit%"/>
	</channel-type>

	<channel-type id="efficiency">
		<item-type unitHint="%">Number:Dimensionless</item-type>
		<label>Efficiency</label>
		<description>Lifetime discharged energy divided by lifetime charged energy.</description>
		<tags>
			<tag>Calculation</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %%"/>
	</channel-type>

	<channel-type id="tower-efficiency" advanced="true">
		<item-type unitHint="%">Number:Dimensionless</item-type>
		<label>Efficiency</label>
		<description>Lifetime discharged energy of the tower divided by its lifetime charged energy.</description>
		<tags>
			<tag>Calculation</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %%"/>
	</channel-type>

	<channel-type id="module-balancing-cells" advanced="true">
		<item-type>Number</item-type>
		<label>Balancing Cells</label>
		<description>Number of cells of the module currently being balanced.</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="balancing-cell-numbers" advanced="true">
		<item-type>String</item-type>
		<label>Balancing Cell Numbers</label>
		<description>Numbers of the cells of the module currently being balanced, e.g. "5, 17", or "None".</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="balancing-cells">
		<item-type>Number</item-type>
		<label>Balancing Cells</label>
		<description>Number of cells currently being balanced.</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="alarm">
		<item-type>Switch</item-type>
		<label>Alarm</label>
		<tags>
			<tag>Alarm</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="status-text">
		<item-type>String</item-type>
		<label>Status Text</label>
		<tags>
			<tag>Status</tag>
			<tag>Info</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="timestamp">
		<item-type>DateTime</item-type>
		<label>Timestamp</label>
		<tags>
			<tag>Status</tag>
			<tag>Timestamp</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="clock-offset">
		<item-type unitHint="s">Number:Time</item-type>
		<label>BMU Clock Offset</label>
		<description>Deviation of the battery clock, read as UTC, from the openHAB clock. Positive if the battery clock is
			ahead.</description>
		<tags>
			<tag>Measurement</tag>
		</tags>
		<state readOnly="true" pattern="%.0f %unit%"/>
	</channel-type>

	<channel-type id="event">
		<kind>trigger</kind>
		<label>Event</label>
		<description>Fired once for every new event log entry. The payload is the source and the event code, e.g. BMU:32 or
			BMS1:7.</description>
		<event>
			<options>
				<option value="BMU:0">BMU: Power on</option>
				<option value="BMU:1">BMU: Power off</option>
				<option value="BMU:2">BMU: Events record</option>
				<option value="BMU:22">BMU: Firmware update started</option>
				<option value="BMU:23">BMU: Firmware update finished</option>
				<option value="BMU:24">BMU: Firmware update failed</option>
				<option value="BMU:25">BMU: Serial number changed</option>
				<option value="BMU:26">BMU: Current calibration</option>
				<option value="BMU:27">BMU: Battery voltage calibration</option>
				<option value="BMU:28">BMU: Pack voltage calibration</option>
				<option value="BMU:29">BMU: SoC/SoH calibration</option>
				<option value="BMU:32">BMU: System status changed</option>
				<option value="BMU:33">BMU: BMS firmware erased</option>
				<option value="BMU:34">BMU: BMS update started</option>
				<option value="BMU:35">BMU: BMS update done</option>
				<option value="BMU:36">BMU: Functional safety info</option>
				<option value="BMU:38">BMU: SOP info</option>
				<option value="BMU:39">BMU: BCU hardware failure</option>
				<option value="BMU:40">BMU: BMS firmware list</option>
				<option value="BMU:41">BMU: MCU list of BMS</option>
				<option value="BMU:101">BMU: Firmware update started</option>
				<option value="BMU:102">BMU: Firmware update successful</option>
				<option value="BMU:103">BMU: Firmware update failed</option>
				<option value="BMU:104">BMU: Switched to the other firmware section</option>
				<option value="BMU:105">BMU: Parameter table update</option>
				<option value="BMU:106">BMU: Serial number changed</option>
				<option value="BMU:111">BMU: Date/time calibration</option>
				<option value="BMU:112">BMU: BMS disconnected from BMU</option>
				<option value="BMU:113">BMU: MU firmware reset</option>
				<option value="BMU:114">BMU: BMU watchdog reset</option>
				<option value="BMU:115">BMU: Pre-charge failed</option>
				<option value="BMU:116">BMU: Address registration failed</option>
				<option value="BMU:117">BMU: Parameter table load failed</option>
				<option value="BMU:118">BMU: System timing log</option>
				<option value="BMU:120">BMU: Parameter table update finished</option>
				<option value="BMS1:0">BMS 1: Power on</option>
				<option value="BMS1:1">BMS 1: Power off</option>
				<option value="BMS1:2">BMS 1: Events record</option>
				<option value="BMS1:3">BMS 1: Timing record</option>
				<option value="BMS1:4">BMS 1: Start charging</option>
				<option value="BMS1:5">BMS 1: Stop charging</option>
				<option value="BMS1:6">BMS 1: Start discharging</option>
				<option value="BMS1:7">BMS 1: Stop discharging</option>
				<option value="BMS1:8">BMS 1: SoC calibration (rough)</option>
				<option value="BMS1:9">BMS 1: SoC calibration (fine)</option>
				<option value="BMS1:10">BMS 1: SoC calibration stop</option>
				<option value="BMS1:11">BMS 1: CAN communication failed</option>
				<option value="BMS1:12">BMS 1: Serial communication failed</option>
				<option value="BMS1:13">BMS 1: Pre-charge command received</option>
				<option value="BMS1:14">BMS 1: Pre-charge successful</option>
				<option value="BMS1:15">BMS 1: Pre-charge failed</option>
				<option value="BMS1:16">BMS 1: End SoC calibration started</option>
				<option value="BMS1:17">BMS 1: Start balancing</option>
				<option value="BMS1:18">BMS 1: Stop balancing</option>
				<option value="BMS1:19">BMS 1: Address registered</option>
				<option value="BMS1:20">BMS 1: System functional safety fault</option>
				<option value="BMS1:21">BMS 1: Events additional info</option>
				<option value="BMS1:101">BMS 1: Firmware update started</option>
				<option value="BMS1:102">BMS 1: Firmware update successful</option>
				<option value="BMS1:103">BMS 1: Firmware update failed</option>
				<option value="BMS1:104">BMS 1: Switched to the other firmware section</option>
