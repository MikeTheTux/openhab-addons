				<option value="BMS3:2">BMS 3: Events record</option>
				<option value="BMS3:3">BMS 3: Timing record</option>
				<option value="BMS3:4">BMS 3: Start charging</option>
				<option value="BMS3:5">BMS 3: Stop charging</option>
				<option value="BMS3:6">BMS 3: Start discharging</option>
				<option value="BMS3:7">BMS 3: Stop discharging</option>
				<option value="BMS3:8">BMS 3: SoC calibration (rough)</option>
				<option value="BMS3:9">BMS 3: SoC calibration (fine)</option>
				<option value="BMS3:10">BMS 3: SoC calibration stop</option>
				<option value="BMS3:11">BMS 3: CAN communication failed</option>
				<option value="BMS3:12">BMS 3: Serial communication failed</option>
				<option value="BMS3:13">BMS 3: Pre-charge command received</option>
				<option value="BMS3:14">BMS 3: Pre-charge successful</option>
				<option value="BMS3:15">BMS 3: Pre-charge failed</option>
				<option value="BMS3:16">BMS 3: End SoC calibration started</option>
				<option value="BMS3:17">BMS 3: Start balancing</option>
				<option value="BMS3:18">BMS 3: Stop balancing</option>
				<option value="BMS3:19">BMS 3: Address registered</option>
				<option value="BMS3:20">BMS 3: System functional safety fault</option>
				<option value="BMS3:21">BMS 3: Events additional info</option>
				<option value="BMS3:101">BMS 3: Firmware update started</option>
				<option value="BMS3:102">BMS 3: Firmware update successful</option>
				<option value="BMS3:103">BMS 3: Firmware update failed</option>
				<option value="BMS3:104">BMS 3: Switched to the other firmware section</option>
				<option value="BMS3:105">BMS 3: Parameter table update</option>
				<option value="BMS3:106">BMS 3: Serial number changed</option>
				<option value="BMS3:107">BMS 3: Current calibration</option>
				<option value="BMS3:108">BMS 3: Battery voltage calibration</option>
